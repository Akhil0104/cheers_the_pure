# Example environment variables for Supabase/PostgreSQL
# Copy this file to .env and fill in your Supabase DB credentials.
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# Stripe Payment Configuration
STRIPE_PUBLIC_KEY=pk_test_YOUR_TEST_PUBLIC_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_TEST_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_TEST_WEBHOOK_SECRET

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@cheers.com

# ── DispatchAI Configuration ─────────────────────────────────────────────────

# Groq LLM — Get key from: https://console.groq.com/keys
GROQ_API_KEY=

# Hindsight Persistent Memory
HINDSIGHT_API_KEY=
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_APP_ID=cheersthepure

# DispatchAI Feature Flags (optional)
DISPATCHAI_ENABLED=True
DISPATCHAI_MAX_MSG_LENGTH=2000
DISPATCHAI_RECALL_LIMIT=10
